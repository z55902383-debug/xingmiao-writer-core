{
  "name": "xingmiao-writer-core",
  "version": "0.6.13",
  "private": true,
  "description": "星喵写作开源核心版 · 本地 AI 小说工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:onboarding:ui": "node tests/desktop-onboarding.mjs && node tests/desktop-planning-flow.mjs --no-screenshots",
    "test:skills:ui": "node tests/desktop-writing-prompts.mjs && node tests/desktop-skill-controls.mjs",
    "test:ui": "node tests/desktop.mjs && node tests/desktop-ai.mjs && node tests/desktop-v02.mjs && node tests/desktop-timeline.mjs && node tests/desktop-planning.mjs && node tests/desktop-atlas.mjs && node tests/desktop-sync.mjs && node tests/desktop-canvas.mjs && node tests/desktop-i18n.mjs",
    "package:dir": "npm run notices:third-party && npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "package:win": "npm run notices:third-party && npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "notices:third-party": "node scripts/third-party-notices.mjs",
    "export:source": "node scripts/export-source.mjs",
    "test:planning:ui": "node tests/desktop-planning.mjs && node tests/desktop-planning-flow.mjs",
    "test:manual:ui": "node tests/desktop-manual-typing.mjs && node tests/desktop-manual-followup.mjs",
    "test:formatting:ui": "node tests/desktop-manuscript-formatting.mjs",
    "test:manual:ideas": "node tests/desktop-manual-ideas.mjs",
    "test:manual:toolbar": "node tests/desktop-manual-toolbar.mjs",
    "test:manual:memo-reference": "node tests/desktop-manual-memo-reference.mjs",
    "test:manual:panels": "node tests/desktop-manual-panel-state.mjs",
    "test:planning:hierarchy": "node tests/desktop-planner-hierarchy.mjs",
    "test:writing:ui": "node tests/desktop-writing-profiles.mjs",
    "test:generation:ui": "node tests/desktop-generation-activity.mjs",
    "test:references:ui": "node tests/desktop-references.mjs",
    "test:context:ui": "node tests/desktop-context-range.mjs",
    "test:continuity:ui": "node tests/desktop-continuity.mjs",
    "test:comparison:ui": "node tests/desktop-comparison.mjs && node tests/desktop-comparison-resize.mjs",
    "test:author-tools:ui": "node tests/desktop-author-tools.mjs",
    "test:knowledge:ui": "node tests/desktop-knowledge.mjs",
    "test:scroll:ui": "node tests/desktop-page-scroll.mjs",
    "test:requirements:ui": "node tests/desktop-writing-requirements.mjs",
    "test:style-blend:ui": "node tests/desktop-style-blend.mjs && node tests/desktop-style-blend-edges.mjs",
    "test:style-layout:ui": "node tests/desktop-style-layout.mjs",
    "test:reference-disclosures:ui": "node tests/desktop-reference-disclosures.mjs",
    "test:candidate-references:ui": "node tests/desktop-candidate-references.mjs",
    "test:reference-full-flow:ui": "node tests/desktop-reference-full-flow.mjs",
    "test:imitation-layout:ui": "node tests/desktop-imitation-layout.mjs",
    "test:imitation:ui": "node tests/desktop-imitation.mjs",
    "test:style-sync:ui": "node tests/desktop-style-sync.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@phosphor-icons/react": "^2.1.10",
    "cytoscape": "^3.34.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.8.5",
    "undici": "^8.11.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "license": "MIT"
}
